{
  "info": {
    "_postman_id": "b3e09871-3312-42da-8971-8bc6a9871021",
    "name": "Inventory Management API",
    "description": "Production Postman collection for Inventory Management with search, filter, stock reserve/release with concurrency handling.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "variantId",
      "value": "22222222-2222-2222-2222-222222222201",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. View All Inventory (Paginated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/inventory?page=1&limit=10&sort_by=created_at&sort_order=DESC",
          "host": ["{{baseUrl}}"],
          "path": ["inventory"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "sort_by", "value": "created_at" },
            { "key": "sort_order", "value": "DESC" }
          ]
        }
      }
    },
    {
      "name": "2. Search Inventory (by SKU or Product Name)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/inventory?search=TSHIRT-RED",
          "host": ["{{baseUrl}}"],
          "path": ["inventory"],
          "query": [
            { "key": "search", "value": "TSHIRT-RED" }
          ]
        }
      }
    },
    {
      "name": "3. Filter Inventory by Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/inventory?status=ACTIVE",
          "host": ["{{baseUrl}}"],
          "path": ["inventory"],
          "query": [
            { "key": "status", "value": "ACTIVE" }
          ]
        }
      }
    },
    {
      "name": "4. Filter Low Stock Inventory",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/inventory?low_stock=true",
          "host": ["{{baseUrl}}"],
          "path": ["inventory"],
          "query": [
            { "key": "low_stock", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "5. Update Stock / Variant",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"available_quantity\": 60,\n  \"price\": 22.50,\n  \"reorder_level\": 15,\n  \"reason\": \"Supplier restock batch #842\",\n  \"reference_id\": \"PO-2026-09-001\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/inventory/{{variantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["inventory", "{{variantId}}"]
        }
      }
    },
    {
      "name": "6. Reserve Stock",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 2,\n  \"reason\": \"Checkout hold for order #ORD-9821\",\n  \"reference_id\": \"ORD-9821\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/inventory/{{variantId}}/reserve",
          "host": ["{{baseUrl}}"],
          "path": ["inventory", "{{variantId}}", "reserve"]
        }
      }
    },
    {
      "name": "7. Release Reserved Stock",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 2,\n  \"reason\": \"Checkout cancelled for order #ORD-9821\",\n  \"reference_id\": \"ORD-9821\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/inventory/{{variantId}}/release",
          "host": ["{{baseUrl}}"],
          "path": ["inventory", "{{variantId}}", "release"]
        }
      }
    },
    {
      "name": "8. View Stock History",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/inventory/{{variantId}}/history?page=1&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["inventory", "{{variantId}}", "history"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "20" }
          ]
        }
      }
    }
  ]
}
