{
  "name": "inventory-management-ai",
  "version": "1.0.0",
  "description": "Production-grade Inventory Management System with PostgreSQL and Sequelize ORM",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/ --ext .js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "test:concurrency": "node tests/concurrency.test.js",
    "client:dev": "npm --prefix frontend run dev",
    "client:build": "npm --prefix frontend run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "@ljharb/tsconfig": "^0.3.2",
    "eslint": "^8.57.1",
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.2"
  }
}
